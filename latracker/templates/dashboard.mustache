{{!
    @template local_latracker/dashboard

    Teacher dashboard: Google Drive OAuth panel + CSV picker + shortcuts.

    Context variables required by this template:
    * courseid - int
    * connected - bool, whether Google Drive is already linked
    * canmanageintegrations - bool, whether the current user may use the Drive panel
    * connecturl - string, URL to start/resume the OAuth flow
    * analyticsurl - string, URL of the Insights page
}}
<div class="local-latracker-dashboard" data-courseid="{{courseid}}" data-analyticsurl="{{analyticsurl}}">

    {{! Nielsen heuristic: visibility of system status. }}
    <div class="alert d-none" role="alert" data-region="status-message" aria-live="polite"></div>

    <div class="row">
        {{#canmanageintegrations}}
        <div class="col-12 col-lg-7">
            <div class="card mb-3">
                <div class="card-header d-flex align-items-center">
                    <i class="fa fa-google fa-fw mr-2" aria-hidden="true"></i>
                    <strong>{{#str}}googledrivepanel, local_latracker{{/str}}</strong>
                </div>
                <div class="card-body">

                    <div data-region="connect-panel" class="{{#connected}}d-none{{/connected}}">
                        <p>{{#str}}connectgoogleexplain, local_latracker{{/str}}</p>
                        <a class="btn btn-primary" href="{{connecturl}}" data-region="connect-button">
                            <i class="fa fa-plug mr-1" aria-hidden="true"></i>
                            {{#str}}connectgoogledrive, local_latracker{{/str}}
                        </a>
                    </div>

                    <div data-region="files-panel" class="{{^connected}}d-none{{/connected}}">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge badge-success">
                                <i class="fa fa-check mr-1" aria-hidden="true"></i>
                                {{#str}}connected, local_latracker{{/str}}
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="refresh-files">
                                <i class="fa fa-refresh mr-1" aria-hidden="true"></i>
                                {{#str}}refresh, local_latracker{{/str}}
                            </button>
                        </div>

                        <p class="text-muted small">{{#str}}selectcsvexplain, local_latracker{{/str}}</p>

                        <div data-region="file-list" class="list-group mb-3" aria-live="polite">
                            <div class="text-muted small p-2" data-region="file-list-empty">
                                {{#str}}loadingfiles, local_latracker{{/str}}
                            </div>
                        </div>

                        <button type="button" class="btn btn-success" data-action="import-selected" disabled>
                            <i class="fa fa-upload mr-1" aria-hidden="true"></i>
                            {{#str}}importselected, local_latracker{{/str}}
                        </button>
                    </div>

                </div>
            </div>
        </div>
        {{/canmanageintegrations}}

        <div class="col-12 col-lg-5">
            <div class="card mb-3">
                <div class="card-header">
                    <strong>{{#str}}shortcuts, local_latracker{{/str}}</strong>
                </div>
                <div class="card-body d-grid gap-2">
                    <a class="btn btn-outline-primary btn-block mb-2" href="{{analyticsurl}}">
                        <i class="fa fa-bar-chart mr-1" aria-hidden="true"></i>
                        {{#str}}gotoinsights, local_latracker{{/str}}
                    </a>
                    <p class="text-muted small mb-0">{{#str}}dashboardhelp, local_latracker{{/str}}</p>
                </div>
            </div>
        </div>
    </div>
</div>

{{#js}}
require(['local_latracker/dashboard'], function(Dashboard) {
    Dashboard.init({{courseid}});
});
{{/js}}
